# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Primary Google Apps Script Web App URL (Active Sheet for daily entries)
APPS_SCRIPT_URL=""

# Secondary Google Apps Script Web App URL (Archive Sheet for historical old data)
ARCHIVE_APPS_SCRIPT_URL=""

# Petpooja Payroll Third-Party Client API (biometric face-scan punch in/out device).
# BASE_URL, Client ID and Client Secret are emailed to you by Petpooja for your organization.
# Configure these as Secrets in the hosting platform (e.g. AI Studio's Secrets panel) --
# never commit real values here. Leaving these blank simply disables the biometric
# import/attendance features; manual overtime entry keeps working as before.
PETPOOJA_BASE_URL=""
PETPOOJA_CLIENT_ID=""
PETPOOJA_CLIENT_SECRET=""
